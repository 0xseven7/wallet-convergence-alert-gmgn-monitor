# Required: create a Doubao Speech app in Volcengine console, then fill these.
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=

# Usually volcano_tts for the historical HTTP non-streaming API.
VOLC_TTS_CLUSTER=volcano_tts

# Set this to the exact Volcengine voice_type you want to use.
# Example from Volcengine docs: zh_female_cancan_mars_bigtts
VOLC_TTS_VOICE_TYPE=zh_female_cancan_mars_bigtts

# Optional: map existing extension voice names to specific Volcengine voice_type values.
VOLC_TTS_VOICE_XIAOXIAO=
VOLC_TTS_VOICE_YUNJIAN=
VOLC_TTS_VOICE_XIAOYI=
VOLC_TTS_VOICE_AVA=

PORT=8788
HOST=0.0.0.0
CORS_ORIGIN=*
MAX_TEXT_LENGTH=500
CACHE_MAX_ITEMS=200
CACHE_TTL_MS=600000
LOG_REQUESTS=true
