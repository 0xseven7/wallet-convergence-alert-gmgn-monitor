{
  "manifest_version": 3,
  "name": "Wallet Convergence Alert",
  "version": "1.9.2",
  "description": "Monitor xxyy.io and gmgn.ai wallet tracking panels, alert on wallet convergence, and redirect GMGN monitor links to the main window.",
  "permissions": ["storage", "tabs", "windows"],
  "host_permissions": ["https://gmgn.ai/*", "https://www.gmgn.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Wallet Convergence Alert",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://pro.xxyy.io/*", "*://www.xxyy.io/*", "*://xxyy.io/*"],
      "js": ["xxyy/network-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://pro.xxyy.io/*", "*://www.xxyy.io/*", "*://xxyy.io/*"],
      "js": ["xxyy/content.js"],
      "css": ["xxyy/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gmgn.ai/follow*", "https://www.gmgn.ai/follow*"],
      "js": ["gmgn/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gmgn.ai/*", "https://www.gmgn.ai/*"],
      "js": ["gmgn/redirector.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://gmgn.ai/*", "*://www.gmgn.ai/*"],
      "js": ["gmgn/content.js"],
      "css": ["gmgn/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
